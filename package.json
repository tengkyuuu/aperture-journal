{
  "name": "aperture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3200",
    "build": "next build --turbopack",
    "start": "next start -p 3200",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-aperture",
    "test:rules": "firebase emulators:exec --only firestore --project demo-aperture \"vitest run tests/rules.test.ts\"",
    "verify:no-secrets": "node scripts/verify-no-secrets.mjs",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "test:vault": "vitest run tests/vault.test.ts",
    "test": "vitest run tests/vault.test.ts && npm run test:rules",
    "verify:gemini": "node scripts/verify-gemini.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "seed": "node scripts/seed.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "logo": "node scripts/logo.mjs"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "@google/genai": "^2.20.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
